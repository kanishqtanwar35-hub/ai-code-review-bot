# Copy to .env and fill in. .env is gitignored â€” never commit it.
#   cp .env.example .env
#
# In GitHub Actions these come from repository secrets instead:
#   Settings -> Secrets and variables -> Actions -> New repository secret
# GITHUB_TOKEN is provided automatically; you do not create it.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Only needed for a local dry run against a real PR:
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
# PR_NUMBER=1
